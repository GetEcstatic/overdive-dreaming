rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public user profiles (minimal fields for community feed)
    match /usersPublic/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Routine templates
    match /routines/{routineId} {
      // Everyone can read (for browsing public routines)
      allow read: if request.auth != null;

      // Any authenticated user can create routines
      allow create: if request.auth != null;

      // Creator can update/delete their own routines
      // Only admin can update system routines
      allow update: if request.auth != null &&
        (resource.data.createdBy == request.auth.uid ||
         (resource.data.createdBy == 'system' && request.auth.uid == 'GRm9WVvOjCMpX7zqD3ZktaiSQzm2'));
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // Routine logs (flat structure)
    match /routineLogs/{routineLogId} {
      function isOwnerBefore() {
        return request.auth != null && request.auth.uid == resource.data.userId;
      }

      function isOwnerAfter() {
        return request.auth != null && request.auth.uid == request.resource.data.userId;
      }

      // Allow list queries where userId filter matches auth user
      allow list: if request.auth != null;
      // Allow get/read of individual docs user owns or public
      allow get: if request.auth != null &&
        (request.auth.uid == resource.data.userId || resource.data.visibility == 'public');
      // Owner can create their own logs.
      allow create: if isOwnerAfter();
      // Owner can update/delete their own logs, without transferring ownership.
      allow update: if isOwnerBefore() && isOwnerAfter();
      allow delete: if isOwnerBefore();
      // Any authenticated user can update likes or commentCount on public logs.
      allow update: if request.auth != null &&
        resource.data.visibility == 'public' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']);
    }

    // Manual routine group-log invites. Hosts create invites after saving
    // their own routine log; recipients review a copied log and save their
    // own analytics record.
    match /groupRoutineInvites/{inviteId} {
      function isHost() {
        return request.auth != null && request.auth.uid == resource.data.hostUserId;
      }
      function isRecipient() {
        return request.auth != null && request.auth.uid == resource.data.recipientUserId;
      }

      allow list: if request.auth != null;
      allow get: if isHost() || isRecipient();
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.hostUserId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.sourceLogData.userId == request.auth.uid;
      allow update: if isRecipient() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'acceptedRoutineLogId',
          'updatedAt'
        ]);
      allow delete: if isHost();
    }

    // Personal bests (user-owned)
    match /personalBests/{pbId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow list: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Seasons (user-owned)
    match /seasons/{seasonId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
    }

    // Comments (social feature)
    match /comments/{commentId} {
      // Any authenticated user can read comments
      allow read: if request.auth != null;
      // Any authenticated user can create a comment (userId must match their own)
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      // Only the comment author can delete their own comment
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      // No updates allowed (comments are immutable)
      allow update: if false;
    }

    // Config (read-only for users)
    match /config/{document} {
      allow read: if request.auth != null;
      // TODO: Add admin role check for write access
    }

    // Dive videos (dynamic video capture feature — see docs/Dynamic video feature.md)
    // Readable by the coach who recorded (ownerId) and by the athlete who is
    // the intended recipient (athleteId). Writable only by ownerId.
    match /diveVideos/{videoId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerId;
      }
      function isAthlete() {
        return request.auth != null &&
          resource.data.athleteId != null &&
          request.auth.uid == resource.data.athleteId;
      }

      // List queries are filtered client-side by ownerId or athleteId.
      allow list: if request.auth != null;
      allow get: if isOwner() || isAthlete();

      // Only the owner (coach / self-recording athlete) may create.
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.ownerId &&
        request.auth.uid == request.resource.data.userId;

      // Owner can update any field. Athlete can only update `giftStatus`
      // (accept / decline the gift) and nothing else.
      allow update: if isOwner() ||
        (isAthlete() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['giftStatus', 'updatedAt']));

      // Only the owner can delete. (The retention-reaper Cloud Function runs
      // with admin privileges and is not constrained by these rules.)
      allow delete: if isOwner();
    }

    // Sessions (legacy / ad-hoc — used as a container id for the dynamic
    // dive recorder flow: /record auto-creates one, then /dive/record/[id]
    // writes the actual diveVideo against that session id).
    match /sessions/{sessionId} {
      allow get: if request.auth != null &&
        request.auth.uid == resource.data.userId;
      allow list: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }
  }
}
