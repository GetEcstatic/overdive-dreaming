{
  "name": "overdive-dreaming",
  "version": "1.0.0",
  "description": "A freediving training tracker for pool disciplines",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-data.ts",
    "seed:logs": "tsx scripts/seed-historical-logs.ts",
    "backfill:profiles": "tsx scripts/backfill-public-profiles.ts",
    "backfill:dive-video-routine-logs": "tsx scripts/backfill-dive-video-routine-logs.ts",
    "backfill:dive-video-routine-logs:dry": "tsx scripts/backfill-dive-video-routine-logs.ts --dry-run",
    "rollback:aida": "tsx scripts/rollback-aida-import.ts",
    "backup": "tsx scripts/backup-firestore.ts",
    "audit": "tsx scripts/audit-data.ts",
    "migrate:activity-types": "tsx scripts/migrate-activity-types.ts",
    "migrate:activity-types:dry": "tsx scripts/migrate-activity-types.ts --dry-run",
    "migrate:packing-volume": "tsx scripts/migrate-add-packing-volume.ts",
    "migrate:packing-volume:dry": "tsx scripts/migrate-add-packing-volume.ts --dry-run",
    "audit:routine-metric-attachment": "tsx scripts/audit-routine-metric-attachment.ts",
    "backfill:routine-metric-attachment": "tsx scripts/audit-routine-metric-attachment.ts --write"
  },
  "keywords": [
    "freediving",
    "training",
    "tracker"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.23",
    "dotenv": "^16.4.7",
    "firebase-tools": "^15.1.0",
    "postcss": "^8.5.6",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.7.0",
    "firebase-admin": "^13.6.0",
    "lucide-svelte": "^0.562.0",
    "xlsx": "^0.18.5"
  }
}
