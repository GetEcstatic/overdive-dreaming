rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Session photos storage (now using routineLogId)
    match /session-photos/{userId}/{routineLogId}/{fileName} {
      // Read: Any authenticated user can view photos
      allow read: if request.auth != null;

      // Write: Only the routine log owner can upload
      // Must be an image and under 5MB
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024;

      // Delete: Only the routine log owner can delete
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Biometric CSV storage (pulse oximeter data)
    match /biometric-csvs/{userId}/{routineLogId}/{fileName} {
      // Read: Any authenticated user can view CSVs (for sharing)
      allow read: if request.auth != null;

      // Write: Only the routine log owner can upload
      // Must be text/csv or text/plain and under 1MB
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (request.resource.contentType.matches('text/.*') || request.resource.contentType == 'application/octet-stream')
                   && request.resource.size < 1 * 1024 * 1024;

      // Delete: Only the routine log owner can delete
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Dive videos (dynamic video capture feature — see docs/Dynamic video feature.md)
    // Path: users/{userId}/videos/{videoId}/{fileName}
    // fileName is one of: clean.mp4 / clean.webm / burned.mp4 / thumb.jpg
    match /users/{userId}/videos/{videoId}/{fileName} {
      // Read: any authenticated user. Firestore rules are the authoritative
      // gate on who sees which video; storage paths are not enumerable.
      allow read: if request.auth != null;

      // Write: only the owner (uploader). The recorder's 5-minute cap is
      // the practical video size bound; do not reject valid videos by bytes.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && (
                request.resource.contentType.matches('video/.*') ||
                     (request.resource.contentType.matches('image/.*')
                        && request.resource.size < 5 * 1024 * 1024)
                   );

      // Delete: owner can delete. (Retention reaper uses admin SDK.)
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }
  }
}
